# Copy to .env and fill in. .env is git-ignored.

# App database (created by tools/init_db.py)
DATABASE_URL=postgresql+psycopg://postgres:admin@localhost:5432/pothole_triage

# Where report photos are stored (relative to backend/)
PHOTO_DIR=../data/photos

# ONNX pothole model (added in M2)
MODEL_PATH=models/pothole_y11s_v2_640.onnx
DETECTOR_CONF=0.15
DETECTION_MODE=enforce

# Shared tokens for the authority page and the manual escalation endpoint
# Abuse limits
DEVICE_DAILY_LIMIT=30
IP_HOURLY_LIMIT=120

# Legacy shared token for scripts; leave empty to require staff logins
AUTHORITY_TOKEN=
INTERNAL_TOKEN=change-me

# Frontend dev origins allowed to call the API
CORS_ORIGINS=["https://localhost:5173","http://localhost:5173"]

# Signs staff login cookies: a long random value (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-to-a-long-random-value
COOKIE_SECURE=false
